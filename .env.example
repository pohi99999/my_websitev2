# ===== Contact form SMTP (required for app/api/contact/route.ts) =====
# Gmail App Password setup
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=peterpohankapersonal@gmail.com
SMTP_PASS=replace_with_google_app_password

# Optional recipients/sender
CONTACT_TO=peterpohankapersonal@gmail.com
CONTACT_FROM=peterpohankapersonal@gmail.com

# ===== Optional external API override =====
# If set, client can send to external backend instead of same-origin /api/contact
# NEXT_PUBLIC_API_ENDPOINT=https://your-backend-domain.com

# ===== Optional Upstash rate limiting =====
# If omitted, in-memory rate limiting is used
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
